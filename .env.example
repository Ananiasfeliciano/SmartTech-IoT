# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================
# SMARTTECH IoT OS — Variáveis de Segurança
# Copie para .env.local e preencha. NUNCA commite .env.local
# =============================================================

# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# --- Criptografia AES-256-GCM (campos sensíveis: senhas Wi-Fi, credenciais) ---
# Gere com: openssl rand -base64 32  |  Mínimo 32 chars  |  Rotacione periodicamente
VITE_ENCRYPTION_KEY=

# --- Ambiente ---
# Values: development | staging | production
VITE_APP_ENV=production

# --- Servidor backend (server.ts) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/smarttech
# JWT_SECRET=   (openssl rand -base64 64)
# REFRESH_TOKEN_SECRET=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# ALLOWED_ORIGINS=https://yourdomain.com

# =============================================================
# CHECKLIST DE SEGURANÇA PRÉ-PRODUÇÃO
# =============================================================
# [ ] VITE_ENCRYPTION_KEY configurada com chave forte
# [ ] Firebase Auth habilitado com email/senha
# [ ] Firestore rules deployadas (firebase deploy --only firestore:rules)
# [ ] HTTPS ativo (automático Firebase Hosting / Vercel)
# [ ] Security headers ativos (firebase.json + vercel.json)
# [ ] CORS restrito — sem wildcard * em produção
# [ ] Rate limit ativo no login (src/lib/rateLimit.ts)
# [ ] Audit logs ativos — Firestore: auditLogs
# [ ] Security logs ativos — Firestore: securityLogs
# [ ] Source maps DESABILITADOS em produção (vite.config: build.sourcemap: false)
# [ ] .env / .env.local NÃO commitados no Git (.gitignore)
# [ ] Backup do Firestore ativo no Firebase Console


# Google Calendar Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
